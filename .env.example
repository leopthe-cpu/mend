# Copy to .env.local for local development. Never commit real values.

# --- Browser (safe to expose: publishable key only) ---
# Optional: defaults to the production project in src/lib/supabase-public-config.ts.
# Set these to point at the local stack (bunx supabase start) or a staging project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server only: Edge Function secrets / CI secrets. NEVER prefix with VITE_ ---
# SUPABASE_SECRET_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# RESEND_API_KEY=
